# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=tenderiq
POSTGRES_PASSWORD=tenderiq
POSTGRES_DB=tenderiq
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# --- Qdrant -----------------------------------------------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6343
QDRANT_GRPC_PORT=6344
QDRANT_API_KEY=
QDRANT_COLLECTION=tenderiq_chunks

# --- Embeddings (Section 8: BGE via sentence-transformers, local) -----------
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIM=768
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=64

# --- LLM (Section 8.1: Gemini primary, Ollama fallback) ---------------------
# Swap provider by changing LLM_PROVIDER only -- no code changes.
LLM_PROVIDER=chain
# Ordered fallback. Gemini first (best quality), Groq second (own quota, still
# hosted), Ollama last (offline only). All three extract correctly with the
# few-shot prompt -- this is a speed/availability ladder, not a quality one.
LLM_CHAIN=gemini,groq,ollama
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Each model has its OWN daily free-tier quota (2.5-flash is only 20/day).
# When one is exhausted the provider fails over to the next automatically.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-2.5-flash
# Requests/minute AND tokens/minute, because which one binds depends on the
# request. The flash-lite models allow well above 5 rpm; 5 was tuned for
# gemini-2.5-flash and made every call pay that model's price.
GEMINI_RPM=15
GEMINI_TPM=240000
GEMINI_RETRIES=4
GEMINI_TIMEOUT_MS=180000
# --- Groq (Section 8.1 tier 2: hosted, fast, own quota) ---------------------
# Absorbs Gemini quota exhaustion without falling all the way back to a local
# model. Still needs internet; Ollama remains the offline last resort.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_RPM=20
GROQ_RETRIES=3
GROQ_TIMEOUT_S=180
# The TOKEN budget is what actually binds, and the limiter paces on it.
# GROQ_RPM is now just a ceiling, not the real control.
GROQ_TPM=8000

# --- xAI / Grok (Section 8.1 tier 2 alternative) ----------------------------
XAI_API_KEY=
XAI_MODEL=grok-3
XAI_RPM=60
XAI_RETRIES=3
XAI_TIMEOUT_S=180
XAI_TPM=16000

# --- Ollama (tier 3) --------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3-14b-40k:latest
OLLAMA_THINK=false
OLLAMA_NUM_CTX=40960
LLM_TEMPERATURE=0.0
LLM_MAX_OUTPUT_TOKENS=32768
# Authentication — replace both values outside local development.
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_TOKEN_MINUTES=60
REVIEWER_REGISTRATION_CODE=replace-with-a-private-invitation-code
# Keep at 2 for free-tier/local models. Paid hosted tiers can usually use 6–12;
# provider rate/token gates still prevent quota overruns.
INGEST_WORKERS=2
INDEX_WORKERS=1
# Return structured Level-1-ready data before the independent Level-3 vector
# index finishes. Recommended for production and large-document demos.
DEFER_VECTOR_INDEXING=true
OCR_WORKERS=3
